.method public X7()Ljava/lang/String;
    .locals 1

    const-string v0, "\t\tcase \t\t\n\twhen tr_type=2 and is_back=1 then\t\t--Purchase Return\n\t\tifnull(ifnull((SELECT Previous.i_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   and Previous.bill_id=items_cost_calc.bill_no*1\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,\n\t\t\t  --Purchase return in general\n\t\t\t  (SELECT Previous.n_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   --and Previous.bill_id=items_cost_calc.bill_no*1\n\t\t\t   and Previous.is_back=0\n\t\t\t   order by Previous.rowid desc limit 1\n              )\n\t\t\t  ),0)\n\t\t\n\t\t\twhen ( (tr_type=1  and is_back=1) ) then\t-- Sales return\n        ifnull(ifnull((SELECT Previous.n_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t \tand Previous.bill_id=items_cost_calc.bill_no*1\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,\n\t\t\t  --Sales return in general\n\t\t\t  (SELECT Previous.n_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t \t--and Previous.bill_id=items_cost_calc.bill_no*1\n\t\t\t   order by Previous.rowid desc limit 1\n              )\n\t\t\t  ),0)\t  \n\t  end\t"

    return-object v0
.end method

