    const-string v0, "update items_cost_calc_m\nset n_u=\n(ifnull((SELECT Previous.avg_month*Previous.tot_qty\n               FROM items_cost_calc_m AS Previous\n               WHERE Previous.id <= items_cost_calc_m.id\n\t\t\t   and Previous.item_id=items_cost_calc_m.item_id\n\t\t\t   and Previous.avg_month<>0\n\t\t\t\t\n\t\t\t   order by Previous.id desc limit 1\n              ) ,0)+\n\t\t\t  ifnull((SELECT Previous.avg_month*Previous.net_qty\n               FROM items_cost_calc_m AS Previous\n               WHERE Previous.id < items_cost_calc_m.id\n\t\t\t   and Previous.item_id=items_cost_calc_m.item_id\n\t\t\t   and Previous.avg_month<>0\n\t\t\t\t\n\t\t\t   order by Previous.id desc limit 1\n              ) ,0)\n\t\t\t  )\n\t\t\t  /\n\t\t\t  (\n\t\t\t  ifnull((SELECT Previous.tot_qty\n               FROM items_cost_calc_m AS Previous\n               WHERE Previous.id <= items_cost_calc_m.id\n\t\t\t   and Previous.item_id=items_cost_calc_m.item_id\n\t\t\t   and Previous.avg_month<>0\n\t\t\t\t\n\t\t\t   order by Previous.id desc limit 1\n              ) ,0)+\n\t\t\t  ifnull((SELECT Previous.net_qty\n               FROM items_cost_calc_m AS Previous\n               WHERE Previous.id < items_cost_calc_m.id\n\t\t\t   and Previous.item_id=items_cost_calc_m.item_id\n\t\t\t   and Previous.avg_month<>0\n\t\t\t\t\n\t\t\t   order by Previous.id desc limit 1\n              ) ,0)\n\n\t\t\t  );\n"

    invoke-virtual {p0, v0}, LZ00;->v0(Ljava/lang/String;)V

    const-string v0, "update items_cost_calc set n_u=\nifnull((select distinct a.n_u from items_cost_calc_m as a where a.month_=1  and a.item_id=items_cost_calc.item_id ),0)\n,n_t=ifnull((select distinct a.n_u from items_cost_calc_m as a where a.month_=1  and a.item_id=items_cost_calc.item_id ),0)\n*( ifnull((SELECT Previous.n_q\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t\tand Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  +(case when ((substr(tr_type,1,1)*1=2 and is_back=0) or (tr_type=1 and is_back=1) or (tr_type=3 and i_q<>0) or tr_type=0 or (tr_type=4 and adj_id in (2,4) ))  then i_q\n\t\t\t  else -1*o_q end)\t)\n\t\t\t  ,r_u=\nifnull((select distinct a.n_u from items_cost_calc_m as a where a.month_=1 and a.item_id=items_cost_calc.item_id ),0)\n,n_t=ifnull((select distinct a.n_u from items_cost_calc_m as a where a.month_=1  and a.item_id=items_cost_calc.item_id ),0)\n*( ifnull((SELECT Previous.n_q\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t\tand Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  +(case when ((substr(tr_type,1,1)*1=2 and is_back=0) or (tr_type=1 and is_back=1) or (tr_type=3 and i_q<>0) or tr_type=0 or (tr_type=4 and adj_id in (2,4) ) )  then i_q\n\t\t\t  else -1*o_q end)\t)\n, n_q = \n              ifnull((SELECT Previous.n_q\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t\tand Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  +(case when ((substr(tr_type,1,1)*1=2 and is_back=0) or (tr_type=1 and is_back=1) or (tr_type=3 and i_q<>0) or tr_type=0 or (tr_type=4 and adj_id in (2,4) ))  then i_q\n\t\t\t  else -1*o_q end)\t\t\t  ;"

