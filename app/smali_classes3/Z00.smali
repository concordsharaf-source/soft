    const-string v0, "create table items_cost_calc_m as\nselect rowid as id, 1 month_,a.item_id as item_id,\nifnull(sum(case when (a.tr_type in(0,2,21) and a.is_back=0) or (a.tr_type=1 and a.is_back=1)  or (a.tr_type=3 and a.i_q<>0) or (a.tr_type=4 and a.adj_id in (2,4))  then a.i_q*a.i_u  when (a.tr_type=2 and a.is_back=1) or (a.tr_type=3 and a.o_q<>0) or (a.tr_type=4 and a.adj_id not in (2,4))  then -1*a.o_q*a.o_u end )/\nsum(case when (a.tr_type in(0,2,21) and a.is_back=0)  or (a.tr_type=1 and a.is_back=1)  or (a.tr_type=3 and a.i_q<>0) or (a.tr_type=4 and a.adj_id in (2,4))  then a.i_q  when (a.tr_type=2 and a.is_back=1)  or (a.tr_type=3 and a.o_q<>0) or (a.tr_type=4 and a.adj_id not in (2,4))  then -1*a.o_q  end),0) avg_month,\nifnull(sum(case when (a.tr_type in(0,2,21) and a.is_back=0) or (a.tr_type=1 and a.is_back=1)  or (a.tr_type=3 and a.i_q<>0) or (a.tr_type=4 and a.adj_id in (2,4))  then a.i_q  when (a.tr_type=2 and a.is_back=1)  or (a.tr_type=3 and a.o_q<>0) or (a.tr_type=4 and a.adj_id not in (2,4) )  then -1*a.o_q  end),0) tot_qty,\nsum(case  when (a.tr_type in(0,2,21) and a.is_back=0)  or (a.tr_type=1 and a.is_back=1)  or (a.tr_type=3 and a.i_q<>0) or (a.tr_type=4 and a.adj_id in (2,4))  then a.i_q  when (a.tr_type in(1,11) and a.is_back=0)  or(a.tr_type=2 and a.is_back=1) or (a.tr_type=3 and a.o_q<>0) or (a.tr_type=4 and a.adj_id not in (2,4))  then -1*a.o_q  \n\nend) net_qty,0 n_u\n\nfrom items_cost_calc a\ngroup by a.item_id\norder by 3,2;"

